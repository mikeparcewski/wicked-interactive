{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Export generated",
  "type": "object",
  "required": [
    "document_id",
    "version",
    "format",
    "path",
    "file"
  ],
  "properties": {
    "version": {
      "type": "integer"
    },
    "format": {
      "enum": [
        "html",
        "pdf",
        "pptx"
      ]
    },
    "path": {
      "type": "string"
    },
    "file": {
      "type": "string"
    },
    "download": {
      "type": [
        "string",
        "null"
      ]
    },
    "project_id": {
      "type": "string",
      "description": "ADDITIVE (DES-PROJECT-001 \u00a72.3): the crew project this doc is bound to. Absent for unbound docs; consumers that don't know the field ignore it."
    }
  },
  "additionalProperties": true
}
