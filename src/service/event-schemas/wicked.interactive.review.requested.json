{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Review pass requested",
  "type": "object",
  "required": [
    "document_id",
    "ts",
    "version"
  ],
  "properties": {
    "document_id": {
      "type": "string"
    },
    "ts": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 0,
      "description": "The version under review. The service stamps the doc's head when the browser omits it, and refuses a version that is not in the doc's lineage."
    },
    "reviewers": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "match",
          "a11y",
          "copy",
          "qe"
        ]
      }
    }
  },
  "additionalProperties": true
}
