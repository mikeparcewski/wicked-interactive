{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A deck's audience was set, proposed, kept or dropped",
  "type": "object",
  "required": ["document_id", "state", "preset", "version"],
  "properties": {
    "document_id": { "type": "string" },
    "state": { "enum": ["set", "proposed", "kept", "dropped"] },
    "preset": { "enum": ["exec", "eng", "customer", "custom"] },
    "label": { "type": ["string", "null"] },
    "version": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": true
}
