{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Structural edit completed",
  "type": "object",
  "required": [
    "document_id",
    "ts",
    "version",
    "results"
  ],
  "properties": {
    "document_id": {
      "type": "string"
    },
    "ts": {
      "type": "string"
    },
    "version": {
      "type": "integer"
    },
    "results": {
      "type": "array",
      "items": {}
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
      "description": "ADDITIVE (DES-CHAT-ARTIFACTS-001 \u00a76.2): the run that made the edit, recorded on the version it lands and on version.created. Absent or null: no run."
    }
  },
  "additionalProperties": true
}
